# --- Immobiliare System / example environment (no real secrets) ---
IMMOBILIARE_DB_URL=sqlite:///data/immobiliare.db
IMMOBILIARE_ENV=production
IMMOBILIARE_LANGUAGE=it
IMMOBILIARE_THEME=light
IMMOBILIARE_BACKUP_DIR=backups
IMMOBILIARE_DOC_DIR=documents
IMMOBILIARE_SESSION_TIMEOUT_MIN=15
IMMOBILIARE_MAX_LOGIN_ATTEMPTS=5
IMMOBILIARE_LOCKOUT_SECONDS=300
IMMOBILIARE_MAX_UPLOAD_MB=15
IMMOBILIARE_BACKUP_KEEP=10
IMMOBILIARE_COMPANY=Immobiliare Demo S.r.l.
IMMOBILIARE_CURRENCY=EUR
IMMOBILIARE_DATE_FORMAT=%d/%m/%Y
# LOG_LEVEL=INFO (used by setup_logging caller)
# Do NOT put real keys here. Encryption key is stored in OS keyring.
